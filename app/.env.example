# Copie para .env (cp .env.example .env) e preencha só o que for usar.
# Nunca comite o .env. As chaves ficam apenas no servidor local.

# Porta local (o servidor só escuta em 127.0.0.1)
PORT=3000

# Fonte de descoberta: Google Places API (New)
# Crie a chave em https://console.cloud.google.com/ e ative "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Redação por IA (opcional). Sem chave, o sistema usa o gerador por modelos.
# AI_PROVIDER aceita: none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Opcionais
# DB_PATH=./data/prospector.db
# USER_AGENT_CONTACT=seu-email-ou-site (aparece no User-Agent ao ler sites)
